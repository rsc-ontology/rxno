        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RXNO_0000011"/>
        <obo:IAO_0000115>The formation of urea from ammonium cyanate. Ammonium cyanate is unstable, and so is formed in situ from either (a) cyanic acid and ammonia, (b) a metal cyanate and an ammonium salt, or (c) a metal cyanate and ammonia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Woehler synthesis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Wohler reaction</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Wohler synthesis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>RXNO</oboInOwl:hasOBONamespace>
        <oboInOwl:id>RXNO:0000289</oboInOwl:id>
        <rdfs:label>Woehler reaction</rdfs:label>
    </owl:Class>
