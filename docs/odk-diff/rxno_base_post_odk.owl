                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_55380"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A carbon-carbon coupling reaction where an enol or enolate reacts with a carbonyl compound to form a beta-hydroxy ketone. The name comes from aldehyde + alcohol.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>https://www.rsc.org/Merck-Index/reaction/r4/</oboInOwl:hasDbXref>
