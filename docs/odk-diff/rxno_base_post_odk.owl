        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RXNO_0000008"/>
        <obo:IAO_0000115>A conjugate addition reaction where a carbon nucleophile adds to the beta-carbon of an alpha,beta-unsaturated system (or an activated carbon-carbon bond).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>https://www.rsc.org/Merck-Index/reaction/r281/</oboInOwl:hasDbXref>
