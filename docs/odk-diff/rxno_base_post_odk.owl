        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RXNO_0000025"/>
        <obo:IAO_0000115>A rearrangement of a 1,2-diketone to an alpha-hydroxy carboxylic acid. It can also be applied to alpha-keto aldehydes. The first exmaple of this reaction was with benzil (PhC(=O)C(=O)Ph) to form benzilic acid, hence the name.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>https://www.rsc.org/Merck-Index/reaction/r34/</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.wikidata.org/wiki/Q818488</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>RXNO</oboInOwl:hasOBONamespace>
        <oboInOwl:id>RXNO:0000075</oboInOwl:id>
        <rdfs:label>benzilic acid rearrangement</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/RXNO_0000075"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A rearrangement of a 1,2-diketone to an alpha-hydroxy carboxylic acid. It can also be applied to alpha-keto aldehydes. The first exmaple of this reaction was with benzil (PhC(=O)C(=O)Ph) to form benzilic acid, hence the name.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>RSC:db</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://orcid.org/0000-0002-4077-4719</oboInOwl:hasDbXref>
