    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/RXNO_0000682 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RXNO_0000682">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RXNO_0000005"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RXNO_0000424"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33308"/>
