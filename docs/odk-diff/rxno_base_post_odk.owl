    <!-- http://purl.obolibrary.org/obo/RXNO_0000655 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RXNO_0000655">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RXNO_0000001"/>
