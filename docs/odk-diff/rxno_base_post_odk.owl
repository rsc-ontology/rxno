    <!-- http://purl.obolibrary.org/obo/RXNO_0000182 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RXNO_0000182">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MOP_0000591"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RXNO_0000002"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004009"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_16526"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The (predominantly ortho) carboxylation of a phenoxide.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>https://www.rsc.org/Merck-Index/reaction/r239/</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>RXNO</oboInOwl:hasOBONamespace>
        <oboInOwl:id>RXNO:0000182</oboInOwl:id>
        <rdfs:comment>Prior to the resolving of https://github.com/rsc-ontology/rxno/issues/27 the parent of this class was wrongly also defined in RXNO under the ID MOP:0000713 (&apos;acetylene reduction&apos;). 
Thus the &quot;has_participant some &apos;carboxy group&apos;&quot; axiom, which was not yet present on &apos;carboxylation&apos; (MOP:0000591) in MOP was copied from this wrongly defined  &apos;carboxylation&apos; in RXNO to the proper one in MOP.

The only RXNO subclass &apos;Kolbe-Schmitt reaction&apos; (RXNO:0000182) of &apos;carboxylation&apos; was also moved to be correctly subsumed in RXNO.</rdfs:comment>
        <rdfs:label>Kolbe-Schmitt reaction</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/RXNO_0000182"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The (predominantly ortho) carboxylation of a phenoxide.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>RSC:db</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://orcid.org/0000-0001-5985-7429</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://orcid.org/0000-0002-4077-4719</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/RXNO_0000182"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
        <owl:annotatedTarget>Prior to the resolving of https://github.com/rsc-ontology/rxno/issues/27 the parent of this class was wrongly also defined in RXNO under the ID MOP:0000713 (&apos;acetylene reduction&apos;). 
Thus the &quot;has_participant some &apos;carboxy group&apos;&quot; axiom, which was not yet present on &apos;carboxylation&apos; (MOP:0000591) in MOP was copied from this wrongly defined  &apos;carboxylation&apos; in RXNO to the proper one in MOP.

The only RXNO subclass &apos;Kolbe-Schmitt reaction&apos; (RXNO:0000182) of &apos;carboxylation&apos; was also moved to be correctly subsumed in RXNO.</owl:annotatedTarget>
        <oboInOwl:created_by rdf:resource="https://orcid.org/0000-0002-1595-3213"/>
    </owl:Axiom>
    


