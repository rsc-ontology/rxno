                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33341"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The formation of a substituted cyclopropylamine by reaction of an amide with a Grignard reagent (carrying a hydrogen atom in the beta-position) in the presence of a titanium(IV) alkoxide as catalyst.</obo:IAO_0000115>
        <dcterms:creator rdf:resource="http://orcid.org/0000-0002-4378-6061"/>
        <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-12-15T10:14:52Z</dcterms:date>
        <oboInOwl:hasOBONamespace>RXNO</oboInOwl:hasOBONamespace>
        <oboInOwl:id>RXNO:0000683</oboInOwl:id>
        <rdfs:comment>The Kulinkovich-de Meijere reaction is a modification of the Kulinkovich reaction (i.e., the reaction of an amide instead of a carboxylic ester under Kulinkovich conditions).</rdfs:comment>
        <rdfs:label xml:lang="en">Kulinkovich-de Meijere reaction</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/RXNO_0000683"/>
