    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/RXNO_0000269 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RXNO_0000269">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MOP_0006371"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RXNO_0000018"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RXNO_0000347"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RXNO_0000423"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35562"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RXNO_0000424"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_22680"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RXNO_0000424"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_73474"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A [3+2] cycloaddition reaction between an azide and an alkyne to give a 1,2,3-triazole, needing only heat to proceed.</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym>Huisgen cycloaddition</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>Huisgen reaction</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>Huisgen&apos;s 1,3-dipolar cycloaddition</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasExactSynonym>&quot;click&quot; reaction</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>&apos;click&apos; reaction</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>alkyne-azide Huisgen cycloaddition</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>alkyne-azide Huisgen reaction</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>azide-alkyne Huisgen cycloaddition</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>azide-alkyne Huisgen reaction</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>azide-alkyne click reaction</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>click reaction</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>RXNO</oboInOwl:hasOBONamespace>
        <oboInOwl:id>RXNO:0000269</oboInOwl:id>
        <rdfs:comment>Note: The term &quot;click reaction&quot; was originally used in a broader sense to refer to any coupling that took place cleanly and quickly in quantitative yield, but it now always seems to be used in this narrower sense.</rdfs:comment>
        <rdfs:label>alkyne-azide click reaction</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/RXNO_0000269"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A [3+2] cycloaddition reaction between an azide and an alkyne to give a 1,2,3-triazole, needing only heat to proceed.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>rsc:db</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/RXNO_0000270 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RXNO_0000270">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MOP_0006371"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RXNO_0000347"/>
        <rdfs:subClassOf>
