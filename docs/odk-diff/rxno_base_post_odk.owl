            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A reaction between an alkyne and a carbonyl group under basic conditions in which a terminal alkyne serves as the CH-acidic moiety. When the carbonyl is an aldehyde, the &apos;Favorskii rearrangement&apos; (RXNO:0000385) takes place and leads to an enone.</obo:IAO_0000115>
        <dcterms:creator rdf:resource="http://orcid.org/0000-0002-4378-6061"/>
        <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-05-17T08:17:36Z</dcterms:date>
        <oboInOwl:hasOBONamespace>RXNO</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>Faworski-Babayan reaction</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>RXNO:0000655</oboInOwl:id>
        <rdfs:label xml:lang="en">Favorskii reaction</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/RXNO_0000655"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A reaction between an alkyne and a carbonyl group under basic conditions in which a terminal alkyne serves as the CH-acidic moiety. When the carbonyl is an aldehyde, the &apos;Favorskii rearrangement&apos; (RXNO:0000385) takes place and leads to an enone.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Favorskii_reaction</oboInOwl:hasDbXref>
    </owl:Axiom>
    


