    <!-- http://purl.obolibrary.org/obo/RXNO_0000247 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RXNO_0000247">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RXNO_0000246"/>
        <obo:IAO_0000115>A joining reaction in which two carbon-carbon double bonds are redistributed among two fragments, i.e. two alkenes. It is typically catalysed by a metal carbenoid, and proceeds via two four-membered intermediates (metallacyclobutanes). The reaction is driven by release of ring strain in the cycloalkene.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>ROMP</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ring-opening metathesis polymerization</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>RXNO</oboInOwl:hasOBONamespace>
        <oboInOwl:id>RXNO:0000247</oboInOwl:id>
        <rdfs:label>ring-opening metathesis polymerisation</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/RXNO_0000247"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A joining reaction in which two carbon-carbon double bonds are redistributed among two fragments, i.e. two alkenes. It is typically catalysed by a metal carbenoid, and proceeds via two four-membered intermediates (metallacyclobutanes). The reaction is driven by release of ring strain in the cycloalkene.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://orcid.org/0000-0002-4077-4719</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>rsc:db</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/RXNO_0000248 -->

