        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A reaction which preserves the number of rings and number of skeletal atoms and in which the molecule rearranges so that one or more atoms or groups of atoms move from one atom to another.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>RSC:db</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://orcid.org/0000-0001-5985-7429</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://orcid.org/0000-0002-4077-4719</oboInOwl:hasDbXref>
