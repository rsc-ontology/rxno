        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/RXNO_0000668"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A particularly mild oxidation method in which, for example, dimethyl sulfoxide and acetic anhydride can be used as oxidizing agents to selectively produce aldehydes from primary alcohols without further oxidation to carboxylic acids. Analogously, secondary alcohols can be oxidized to form ketones.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/Albright-Goldman_oxidation"/>
    </owl:Axiom>
    


