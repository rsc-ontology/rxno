        <obo:IAO_0000115>Any primary amine in which the substituent attached to nitrogen is an alkyl group.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>CHEBI:2587</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>kegg.compound:C01664</oboInOwl:hasDbXref>
