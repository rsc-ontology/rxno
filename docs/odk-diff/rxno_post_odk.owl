     xmlns:subsets="http://purl.obolibrary.org/obo/ro/subsets#"
     xmlns:oboInOwl="http://www.geneontology.org/formats/oboInOwl#">
    <owl:Ontology rdf:about="http://purl.obolibrary.org/obo/rxno.owl">
        <owl:versionIRI rdf:resource="http://purl.obolibrary.org/obo/rxno/releases/2026-10-07/rxno.owl"/>
        <dcterms:description>RXNO is the name reaction ontology. It contains more than 500 classes representing organic reactions such as the Diels–Alder cyclization.</dcterms:description>
        <dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
        <dcterms:title>RXNO</dcterms:title>
        <oboInOwl:date>16:12:2021 15:55</oboInOwl:date>
        <oboInOwl:default-namespace>RXNO</oboInOwl:default-namespace>
        <oboInOwl:hasOBOFormatVersion>1.4</oboInOwl:hasOBOFormatVersion>
        <owl:versionInfo>2026-10-07</owl:versionInfo>
    </owl:Ontology>
    


