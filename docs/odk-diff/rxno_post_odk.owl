        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A carbon-carbon coupling reaction where a carbonyl compound reacts with a phosphonium ylide to give an alkene.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>RSC:db</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://orcid.org/0000-0001-5985-7429</oboInOwl:hasDbXref>
