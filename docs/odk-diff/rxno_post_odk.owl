        <obo:IAO_0000115>The Tsuji-Wilkinson decarbonylation reaction is a method for the decarbonylation of aldehydes and some acyl chlorides.</obo:IAO_0000115>
        <dcterms:creator rdf:resource="http://orcid.org/0000-0002-4378-6061"/>
        <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-11-04T12:09:26Z</dcterms:date>
