    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#exactMatch"/>
        <owl:annotatedTarget rdf:resource="http://purl.obolibrary.org/obo/hp#abbreviation"/>
        <sssom:mapping_justification rdf:resource="https://w3id.org/semapv/vocab/ManualMappingCuration"/>
        <sssom:object_label>abbreviation</sssom:object_label>
