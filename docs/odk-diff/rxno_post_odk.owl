            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Synthesis of diarylmethane derivatives using an aldehyde and an aromatic compound at low temperature in an acidic medium.</obo:IAO_0000115>
        <dcterms:creator rdf:resource="http://orcid.org/0000-0002-4378-6061"/>
        <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-12-16T12:54:23Z</dcterms:date>
        <oboInOwl:hasOBONamespace>RXNO</oboInOwl:hasOBONamespace>
        <oboInOwl:id>RXNO:0000691</oboInOwl:id>
        <rdfs:comment>A Friedel-Crafts type reaction proceeding via electrophilic aromatic substitution.</rdfs:comment>
        <rdfs:label xml:lang="en">Baeyer diarylmethane synthesis</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/RXNO_0000691"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Synthesis of diarylmethane derivatives using an aldehyde and an aromatic compound at low temperature in an acidic medium.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://doi.org/10.1016/B978-0-08-096630-4.00412-8</oboInOwl:hasDbXref>
    </owl:Axiom>
    


