    <!-- http://purl.obolibrary.org/obo/RXNO_0000022 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RXNO_0000022">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/RXNO_0000421"/>
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/RXNO_0000422"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MOP_0000550"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RXNO_0000332"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RXNO_0000425"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_28694"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An aromatic substitution reaction where an aryl diazonium salt reacts with copper powder and hydrochloric acid or hydrobromic acid to form an aromatic chloride or bromide.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>RXNO</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>Gattermann reaction</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>RXNO:0000022</oboInOwl:id>
