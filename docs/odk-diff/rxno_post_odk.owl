            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The intramolecular esterification of a carboxylic acid group with an alcohol group using 2,4,6-trichlorobenzoyl chloride (Yamaguchi reagent) - an intramolecular Yamaguchi esterification.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Yamaguchi lactonization</oboInOwl:hasExactSynonym>
