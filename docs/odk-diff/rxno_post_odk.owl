        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RXNO_0000025"/>
        <obo:IAO_0000115>An adaptation of the Claisen rearrangement that transforms a beta-keto allyl ester into a gamma,delta-allyl ketone. It uses base and high temperature or milder conditions with a ruthenium or palladium complex as catalyst.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>https://www.rsc.org/Merck-Index/reaction/r72/</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Kimel-Cope rearrangement</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>RXNO</oboInOwl:hasOBONamespace>
        <oboInOwl:id>RXNO:0000248</oboInOwl:id>
        <rdfs:label>Carroll rearrangement</rdfs:label>
    </owl:Class>
