            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A functional group oxidation where an aromatic amine is transformed into an aromatic diazonium salt.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>diazotization</oboInOwl:hasExactSynonym>
