                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/RXNO_0000441"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A reaction which preserves the number of rings and number of skeletal atoms and in which the molecule rearranges so that one or more atoms or groups of atoms move from one atom to another.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>RXNO</oboInOwl:hasOBONamespace>
