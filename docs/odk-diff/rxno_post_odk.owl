        <obo:IAO_0000115>The formation of a substituted primary cyclopropylamine by reaction of a nitrile with a Grignard reagent (carrying a hydrogen atom in the beta-position) in the presence of a titanium(IV) alkoxide as catalyst.</obo:IAO_0000115>
        <dcterms:creator rdf:resource="http://orcid.org/0000-0002-4378-6061"/>
        <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-12-15T10:47:43Z</dcterms:date>
