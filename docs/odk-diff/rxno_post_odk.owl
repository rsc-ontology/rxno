            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A carbon-carbon coupling reaction where ammonia or an amine reacts with a non-enolisable aldehyde, often methanal, and an enolisable carbonyl compound to form a beta-amino carbonyl compound.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>https://www.rsc.org/Merck-Index/reaction/r265/</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.wikidata.org/wiki/Q183055</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>RXNO</oboInOwl:hasOBONamespace>
        <oboInOwl:id>RXNO:0000032</oboInOwl:id>
        <rdfs:label>Mannich reaction</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/RXNO_0000032"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A carbon-carbon coupling reaction where ammonia or an amine reacts with a non-enolisable aldehyde, often methanal, and an enolisable carbonyl compound to form a beta-amino carbonyl compound.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>RSC:db</oboInOwl:hasDbXref>
    </owl:Axiom>
    


