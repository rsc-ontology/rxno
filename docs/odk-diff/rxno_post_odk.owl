                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RXNO_0000425"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33363"/>
                    </owl:Restriction>
                </owl:intersectionOf>
