AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "chebi") <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/CHEBI_72544> "flavonoid")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/CHEBI_72544> "CHEBI:72544")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/CHEBI_72544> <http://purl.obolibrary.org/obo/chebi/3_STAR>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CHEBI_72544> "flavonoids")
SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_72544> <http://purl.obolibrary.org/obo/CHEBI_25806>)
SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_72544> <http://purl.obolibrary.org/obo/CHEBI_50860>)

